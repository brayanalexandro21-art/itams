# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

PORT=3001

# Clave para firmar las sesiones (JWT). Usa un texto largo y aleatorio.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Base de datos en la nube (Turso) ---
# Si las dejas vacías, se usa el archivo local backend/itams.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Archivos en la nube (Cloudinary) ---
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Si la dejas vacía, los archivos se guardan en backend/uploads
CLOUDINARY_URL=
